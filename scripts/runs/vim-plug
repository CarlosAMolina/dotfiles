#!/usr/bin/env bash

set -e # Exit if any command fails.

# Usage:
#   ./runs/vim-plug             Install.
#   ./runs/vim-plug --dry       Show what would be executed, without doing it.

dry_run="0"
downloads_path="$HOME/.cache/dotfiles/downloads"
plug_target="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site/autoload/plug.vim"
cached_plug_path="$downloads_path/plug.vim"

while [[ $# -gt 0 ]]; do
    echo "ARG: \"$1\""
    if [[ "$1" == "--dry" ]]; then
        dry_run="1"
    fi
    shift
done

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN] $@"
    else
        echo "[DEBUG] $@"
    fi
}

execute() {
    log "execute $@"
    if [[ $dry_run == "1" ]]; then
        return
    fi
    "$@"
}

create_dir() {
    if [ -d "$@" ]; then
        log The "$@" folder already exists
    else
        log The "$@" folder does not exists. Creating
        execute mkdir -p "$@"
    fi
}

get_linux_distribution() {
    if [[ ! -f /etc/os-release ]]; then
        echo "[ERROR] Unable to determine Linux distribution"
        exit 1
    fi

    . /etc/os-release

    case "${ID:-}" in
      arch|archarm)
        echo "arch"
        ;;
      ubuntu|debian|linuxmint|pop)
        echo "debian"
        ;;
      *)
        case " ${ID_LIKE:-} " in
          *" arch "*)
            echo "arch"
            ;;
          *" debian "*)
            echo "debian"
            ;;
          *)
            echo "${ID:-unknown}"
            ;;
        esac
        ;;
    esac
}

install_curl() {
    case "$(uname)" in
      Darwin)
        if ! command -v curl >/dev/null 2>&1; then
            echo "[ERROR] curl is expected to be available on macOS"
            exit 1
        fi
        ;;

      *BSD*)
        execute sudo pkg install -y curl
        ;;

      Linux)
        distro="$(get_linux_distribution)"

        case "$distro" in
          arch)
            execute sudo pacman -S --needed curl
            ;;

          debian)
            execute sudo apt install -y curl
            ;;

          *)
            echo "[ERROR] Unsupported Linux distribution: $distro"
            exit 1
            ;;
        esac
        ;;

      *)
        echo "[ERROR] Unsupported OS: $(uname)"
        exit 1
        ;;
    esac
}

install_vim_plug() {
    # https://github.com/junegunn/vim-plug?tab=readme-ov-file#neovim
    if [ -s "$cached_plug_path" ]; then
        log "Found cached $cached_plug_path, skipping download"
    else
        log "No valid cached download found at $cached_plug_path, downloading"
        create_dir "$downloads_path"
        execute curl -fL "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim" -o "$cached_plug_path"
    fi
    create_dir "$(dirname "$plug_target")"
    execute cp "$cached_plug_path" "$plug_target"
    # To run the following command the vim_plug must be configured in the config file in ~/.config/nvim/
    # --headless: run without opening the UI.
    # +PlugInstall --sync: install plugins and wait for installation to finish.
    # +qa: quit Neovim afterward.
    execute nvim --headless '+PlugInstall --sync' +qa
}

install_curl
install_vim_plug
