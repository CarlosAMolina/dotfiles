#!/usr/bin/env bash

set -e # Exit if any command fails.

# Usage:
#   ./runs/neovim             Install.
#   ./runs/neovim --dry       Show what would be executed, without doing it.
#   ./runs/neovim --uninstall Remove.
#
# References:
# https://github.com/BurntSushi/ripgrep?tab=readme-ov-file#installation
#
# Requirements
# - ripgrep. Required by telescope.
# - xclip. To use clipboard.

script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

dry_run="0"
uninstall="0"

while [[ $# -gt 0 ]]; do
    echo "ARG: \"$1\""

    if [[ "$1" == "--dry" ]]; then
        dry_run="1"
    fi

    if [[ "$1" == "--uninstall" ]]; then
        uninstall="1"
    fi

    shift
done


#
# Helpers
#

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"



install_extras() {
    execute "$script_dir/vim-plug"
    execute "$script_dir/nerd-fonts"
}


#
# Install from source
#

install_from_source() {
    # https://github.com/neovim/neovim/blob/master/BUILD.md#build-prerequisites

    execute pushd /tmp > /dev/null
    execute git clone --depth 1 --branch stable https://github.com/neovim/neovim
    execute cd neovim
    execute gmake CMAKE_BUILD_TYPE=Release

    case "$(get_os)" in
      bsd)
        execute sudo gmake install
        ;;

      *)
        execute sudo make install
        ;;
    esac

    execute popd > /dev/null
}


#
# Darwin
#

set_nvim_darwin_config() {
    opt_path="$HOME/.local/opt"
    install_path="$HOME/.local/bin"
    downloads_path="$HOME/.cache/dotfiles/downloads"
    bin_name="nvim"

    # Pinned to a fixed release (not "latest") for security/reproducibility.
    # https://github.com/neovim/neovim/releases/tag/v0.12.4
    nvim_tag="v0.12.4"

    case $(uname -m) in
      arm64|aarch64)
        arch="arm64"
        ;;

      x86_64|amd64)
        arch="x86_64"
        ;;

      *)
        echo "[ERROR] Unsupported architecture: $(uname -m)"
        exit 1
        ;;
    esac

    dir_name="nvim-macos-${arch}"
    asset="${dir_name}.tar.gz"

    # Cache filename includes the tag so different pinned versions never
    # collide or get reused by mistake.
    cached_asset_path="$downloads_path/${dir_name}-${nvim_tag}.tar.gz"
}

get_installed_nvim_version() {
    "$opt_path/$dir_name/bin/$bin_name" \
        --version 2>/dev/null |
        head -n 1 |
        awk '{print $2}'
}

is_nvim_darwin_installed() {
    if [[ ! -d "$opt_path/$dir_name" ]]; then
        return 1
    fi

    if [[ ! -x "$opt_path/$dir_name/bin/$bin_name" ]]; then
        return 1
    fi

    installed_version="$(get_installed_nvim_version)"
    [[ "$installed_version" == "$nvim_tag" ]]
}

download_nvim_darwin() {
    if [[ -s "$cached_asset_path" ]]; then
        log "Found cached $cached_asset_path, skipping download"
        return
    fi

    log "No valid cached download found at $cached_asset_path, downloading"

    mkdir -p "$downloads_path"

    url="https://github.com/neovim/neovim/releases/download/${nvim_tag}/${asset}"
    execute curl -fL "$url" -o "$cached_asset_path"
}

install_nvim_darwin() {
    set_nvim_darwin_config

    if is_nvim_darwin_installed; then
        log "$dir_name $nvim_tag is already installed at $opt_path, skipping install"
        return 0
    fi

    download_nvim_darwin
    uninstall_nvim_darwin

    execute mkdir -p "$opt_path"
    execute tar -xzf "$cached_asset_path" -C "$opt_path"

    # curl (unlike Safari/Finder) does not set com.apple.quarantine, so this
    # should normally be a no-op. If it IS present, ask the user to remove it
    # manually rather than running xattr from the script.
    if [[ $dry_run != "1" ]] &&
       xattr -p com.apple.quarantine "$opt_path/$dir_name" >/dev/null 2>&1; then

        log "The extracted files are quarantined. Please run manually:"
        log "    xattr -dr com.apple.quarantine \"$opt_path/$dir_name\""
        log "Press Enter to continue when done"

        execute read -p "" </dev/tty
    fi

    execute mkdir -p "$install_path"
    execute ln -sf \
        "$opt_path/$dir_name/bin/$bin_name" \
        "$install_path/$bin_name"

    installed_version="$(get_installed_nvim_version)"

    if [[ "$installed_version" != "$nvim_tag" ]]; then
        echo "[ERROR] $nvim_tag --version failed after installation"
        return 1
    fi

    log "Installation verified (neovim): $installed_version"
}

uninstall_nvim_darwin() {
    set_nvim_darwin_config

    if [[ -d "$opt_path/$dir_name" ]]; then
        execute rm -rf "$opt_path/$dir_name"
    else
        log "$dir_name is not installed at $opt_path"
    fi

    if [[ -e "$install_path/$bin_name" ]] ||
       [[ -L "$install_path/$bin_name" ]]; then

        execute rm -f "$install_path/$bin_name"
    else
        log "$bin_name is not installed at $install_path"
    fi
}

install_darwin() {
    execute "$script_dir/ripgrep"
    install_nvim_darwin
    install_extras
}


#
# Arch Linux
#

install_arch() {
    execute sudo pacman -S --needed \
        neovim \
        ripgrep \
        xclip

    install_extras
}

uninstall_arch() {
    execute sudo pacman -Rs neovim
}


#
# Debian / Ubuntu
#

install_debian() {
    # https://github.com/neovim/neovim/blob/master/BUILD.md#ubuntu--debian

    execute sudo apt install -y \
        ninja-build \
        gettext \
        cmake \
        build-essential \
        curl \
        ripgrep \
        xclip

    execute "$script_dir/git"

    install_from_source
    install_extras
}


#
# FreeBSD
#

install_freebsd() {
    # https://github.com/neovim/neovim/blob/master/BUILD.md#freebsd

    execute sudo pkg install -y \
        cmake \
        gmake \
        gettext \
        curl \
        ripgrep \
        xclip

    execute "$script_dir/git"

    install_from_source
    install_extras
}


#
# Uninstall
#

uninstall_neovim() {
    case "$(get_os)" in
      darwin)
        uninstall_nvim_darwin
        ;;

      arch)
        uninstall_arch
        ;;

      *)
        echo "[ERROR] --uninstall is not supported on this OS"
        exit 1
        ;;
    esac
}


#
# Install
#

install_neovim() {
    case "$(get_os)" in
      darwin)
        install_darwin
        ;;

      bsd)
        install_freebsd
        ;;

      arch)
        install_arch
        ;;

      debian)
        install_debian
        ;;

      *)
        echo "[ERROR] Unsupported OS: $(get_os)"
        exit 1
        ;;
    esac
}


#
# Main
#

if [[ $uninstall == "1" ]]; then
    uninstall_neovim
else
    install_neovim
fi
